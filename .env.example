# =============================================================================
# TheAuraLab Ecommerce — root .env file
# Copy to .env (or `.env`) and fill in real values before `docker compose up`.
# All variables below are read by docker-compose.yml and forwarded to services.
# =============================================================================

# ─── Core secrets ────────────────────────────────────────────────────────────
# JWT secret used by auth/identity/authorization services. 32+ chars recommended.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
# Used by auth-service to sign refresh tokens
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
# Shared secret for service-to-service calls (sent as the x-internal-token header):
# auth-service → identity-service /internal endpoints, and identity/customer →
# authorization-service. Required: without it signup, login and permission checks fail.
INTERNAL_SERVICE_TOKEN=change-me-to-a-third-long-random-string
# Block login until the email is verified. No email provider exists yet, so set
# this to false in environments where users must log in without verifying.
REQUIRE_VERIFIED_EMAIL=true

# ─── OpenAI / AI service ─────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=TheAuraLab
POSTGRES_PASSWORD=TheAuraLab_dev_pw
POSTGRES_DB=TheAuraLab
POSTGRES_PORT=5432

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ─── ChromaDB (used for vector memory) ────────────────────────────────────────
CHROMA_PORT=8000

# ─── Ports exposed on host (override only if you have local conflicts) ───────
API_GATEWAY_PORT=8001
FRONTEND_PORT=3000

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API. Used by NestJS services.
CORS_ORIGINS=http://localhost:3000,http://localhost:8001

# ─── Node environment ────────────────────────────────────────────────────────
NODE_ENV=production

# ─── Frontend build-time vars (must be set at `docker build`, NOT runtime) ──
NEXT_PUBLIC_WS_URL=http://localhost:8001
NEXT_PUBLIC_API_URL=http://localhost:8001/api

# ─── Log rotation (JSON to stdout; sized by compose log driver) ─────────────
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3