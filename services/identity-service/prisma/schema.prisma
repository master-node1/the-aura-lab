generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Identity {
  id                 String           @id @default(uuid()) @db.Uuid
  displayName        String           @map("display_name")
  firstName          String?          @map("first_name")
  lastName           String?          @map("last_name")
  email              String           @unique
  mobileNumber       String?          @unique @map("mobile_number")
  status             IdentityStatus   @default(PENDING_VERIFICATION)
  preferredLanguage  String           @default("en") @map("preferred_language")
  timeZone           String           @default("UTC") @map("time_zone")
  profileImage       String?          @map("profile_image")
  registrationSource String?          @map("registration_source")
  lastLoginAt        DateTime?        @map("last_login_at")
  isEmailVerified    Boolean          @default(false) @map("is_email_verified")
  isMobileVerified   Boolean          @default(false) @map("is_mobile_verified")
  deletedAt          DateTime?        @map("deleted_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  providers          IdentityProvider[]
  auditLogs          IdentityAuditLog[]

  @@map("identities")
}

model IdentityProvider {
  id           String   @id @default(uuid()) @db.Uuid
  identityId   String   @map("identity_id") @db.Uuid
  provider     String   // local, google, apple, facebook, microsoft
  externalId   String?  @map("external_id")
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")

  identity     Identity @relation(fields: [identityId], references: [id])

  @@unique([provider, externalId])
  @@map("identity_providers")
}

model IdentityAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  identityId  String   @map("identity_id") @db.Uuid
  action      String
  changedBy   String?  @map("changed_by")
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  identity    Identity @relation(fields: [identityId], references: [id])

  @@map("identity_audit_logs")
}

enum IdentityStatus {
  PENDING_VERIFICATION
  VERIFIED
  ACTIVE
  SUSPENDED
  LOCKED
  DEACTIVATED
  ARCHIVED
  DELETED
}
