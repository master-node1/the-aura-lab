generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id                 String           @id @default(uuid()) @db.Uuid
  identityId         String           @unique @map("identity_id") @db.Uuid
  email              String           @unique
  mobileNumber       String?          @unique @map("mobile_number")
  firstName          String           @map("first_name")
  lastName           String           @map("last_name")
  preferredLanguage  String           @default("en") @map("preferred_language")
  preferredCurrency  String           @default("USD") @map("preferred_currency")
  profilePicture     String?          @map("profile_picture")
  status             CustomerStatus   @default(ACTIVE)
  emailVerified      Boolean          @default(false) @map("email_verified")
  mobileVerified     Boolean          @default(false) @map("mobile_verified")
  registrationDate   DateTime         @default(now()) @map("registration_date")
  lastLoginAt        DateTime?        @map("last_login_at")
  deletedAt          DateTime?        @map("deleted_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  addresses          CustomerAddress[]
  preferences        CustomerPreferences?
  auditLogs          CustomerAuditLog[]
  events             CustomerEvent[]

  @@index([status, deletedAt])
  @@map("customers")
}

model CustomerAddress {
  id                  String      @id @default(uuid()) @db.Uuid
  customerId          String      @map("customer_id") @db.Uuid
  label               String?
  recipientName       String      @map("recipient_name")
  phone               String?
  line1               String
  line2               String?
  city                String
  state               String?
  postalCode          String      @map("postal_code")
  country             String
  type                AddressType @default(SHIPPING)
  isDefaultShipping   Boolean     @default(false) @map("is_default_shipping")
  isDefaultBilling    Boolean     @default(false) @map("is_default_billing")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  customer            Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

model CustomerPreferences {
  id                    String   @id @default(uuid()) @db.Uuid
  customerId            String   @unique @map("customer_id") @db.Uuid
  language              String   @default("en")
  currency              String   @default("USD")
  emailMarketing        Boolean  @default(false) @map("email_marketing")
  smsMarketing          Boolean  @default(false) @map("sms_marketing")
  pushNotifications     Boolean  @default(true) @map("push_notifications")
  orderNotifications    Boolean  @default(true) @map("order_notifications")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  customer              Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_preferences")
}

model CustomerAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  action      String
  changedBy   String?  @map("changed_by")
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at")
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("customer_audit_logs")
}

model CustomerEvent {
  id          String    @id @default(uuid()) @db.Uuid
  customerId  String    @map("customer_id") @db.Uuid
  eventType   String    @map("event_type")
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")
  attempts    Int       @default(0)
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([publishedAt, createdAt])
  @@map("customer_events")
}

enum CustomerStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
  DELETED
}

enum AddressType {
  SHIPPING
  BILLING
  BOTH
}